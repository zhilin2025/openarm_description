  <xacro:macro name="v11_head">
    <xacro:v11_link name="openarm_head_link0"
                    visual_mesh="meshes/head/v11/visual/openarm_head_link0.stl"
                    collision_mesh="meshes/head/v11/collision/openarm_head_link0.stl"
                    inertial_xyz="3.82136428886854E-07 -0.0019000995698488 -0.00644498533541293"
                    inertial_rpy="0 0 0"
                    mass="0.538360258292282"
                    ixx="0.000216348629003961"
                    ixy="1.19627488782688E-09"
                    ixz="-4.76105869335567E-09"
                    iyy="0.000428733658888925"
                    iyz="2.30027219577875E-06"
                    izz="0.000472039479089695" />
    <xacro:v11_fixed_joint name="openarm_head_joint0"
                           parent="${v11_root_name}"
                           child="openarm_head_link0"
                           xyz="0 0.0018601 0.42896" />

    <xacro:v11_link name="openarm_camera_link0"
                    visual_mesh="meshes/sensors/v11/visual/openarm_camera_link0.stl"
                    collision_mesh="meshes/sensors/v11/collision/openarm_camera_link0.stl"
                    inertial_xyz="0.000245615871234952 0.000549779467919009 -6.02924529609083E-05"
                    inertial_rpy="0 0 0"
                    mass="0.349032499464003"
                    ixx="3.07698794946109E-05"
                    ixy="-1.90720109226455E-06"
                    ixz="-2.4098883814607E-08"
                    iyy="0.000212768783227407"
                    iyz="8.46225491124618E-09"
                    izz="0.000213427968703466" />
    <xacro:v11_fixed_joint name="openarm_camera_joint0"
                           parent="${v11_root_name}"
                           child="openarm_camera_link0"
                           xyz="0 -0.029194 0.45743"
                           rpy="0.43633 0 0" />
  </xacro:macro>

  <xacro:if value="${bimanual}">
    <xacro:v11_arm_left />
    <xacro:v11_arm_right />
    <xacro:v11_head />
  </xacro:if>

  <xacro:unless value="${bimanual}">
    <xacro:if value="${arm_prefix == 'right_'}">
      <xacro:v11_arm_right />
    </xacro:if>
    <xacro:unless value="${arm_prefix == 'right_'}">
      <xacro:v11_arm_left />
    </xacro:unless>
    <xacro:v11_head />
  </xacro:unless>

  <!-- 地面坐标系锚点：world 与机身基座 (body_link0) 重合。
       真机 / MoveIt / 仿真共用；仿真若需离地高度请在 spawn 时加 -z 偏移，
       不要在此处修改 world→base 变换。 -->
  <link name="world" />
  <joint name="world_to_openarm" type="fixed">
    <origin xyz="0 0 0.38" rpy="0 0 0" />
    <parent link="world" />
    <child link="${v11_root_name}" />
  </joint>

  <xacro:if value="${ros2_control}">
    <xacro:if value="${bimanual}">
      <xacro:openarm_bimanual_ros2_control
        arm_type="${arm_type}"
        control_gains="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/control_gains.yaml')}"
        left_can_interface="${left_can_interface}"
        right_can_interface="${right_can_interface}"
        motor_backend="${motor_backend}"
        robstride_master_id="${robstride_master_id}"
        robstride_joint_ids="${robstride_joint_ids}"
        robstride_joint_types="${robstride_joint_types}"
        robstride_gripper_id="${robstride_gripper_id}"
        robstride_gripper_type="${robstride_gripper_type}"
        auto_return_to_zero_on_activate="${auto_return_to_zero_on_activate}"
        limit_margin="${limit_margin}"
        limit_stop_margin="${limit_stop_margin}"
        limit_decel_factor="${limit_decel_factor}"
        zero_torque_kd="${zero_torque_kd}"
        use_fake_hardware="${use_fake_hardware}"
        fake_sensor_commands="false"
        hand="${hand}"
        left_arm_prefix="left_"
        right_arm_prefix="right_"
        can_fd="true" />
    </xacro:if>
    <xacro:unless value="${bimanual}">
      <xacro:openarm_arm_ros2_control
        arm_type="${arm_type}"
        control_gains="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/control_gains.yaml')}"
        can_interface="${can_interface}"
        motor_backend="${motor_backend}"
        robstride_master_id="${robstride_master_id}"
        robstride_joint_ids="${robstride_joint_ids}"
        robstride_joint_types="${robstride_joint_types}"
        robstride_gripper_id="${robstride_gripper_id}"
        robstride_gripper_type="${robstride_gripper_type}"
        auto_return_to_zero_on_activate="${auto_return_to_zero_on_activate}"
        limit_margin="${limit_margin}"
        limit_stop_margin="${limit_stop_margin}"
        limit_decel_factor="${limit_decel_factor}"
        zero_torque_kd="${zero_torque_kd}"
        use_fake_hardware="${use_fake_hardware}"
        fake_sensor_commands="false"
        hand="${hand}"
        arm_prefix="${arm_prefix}"
        can_fd="true" />
    </xacro:unless>
  </xacro:if>

</robot>