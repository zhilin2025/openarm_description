    <link name="openarm_right_hand" />
    <joint name="openarm_right_hand_joint" type="fixed">
      <parent link="openarm_right_link7" />
      <child link="openarm_right_hand" />
      <origin xyz="0 0 0" rpy="0 0 0" />
