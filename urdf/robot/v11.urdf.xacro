             xyz="-0.0197784297364522 -0.00206652971066514 0.00074375541566038" axis="-0.993890941526293 -0.103845714103361 0.0373746440028857" lower="-1.29" upper="1.29" effort="7" velocity="20.943946" />

    <link name="openarm_right_link7" />
