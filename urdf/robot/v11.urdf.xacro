                    iyz="4.45099267065899E-08"
                    izz="0.000440620671658457" />
    <xacro:v11_joint name="openarm_right_joint6" parent="openarm_right_link5" child="openarm_right_link6"
             xyz="0 0 -0.1259" axis="0 -1 0" lower="-0.6" upper="0.6" effort="7" velocity="20.943946" />

    <xacro:v11_link name="openarm_right_link7"
                    visual_mesh="meshes/arm/v11/visual/openarm_right_link7.stl"
                    collision_mesh="meshes/arm/v11/collision/openarm_right_link7.stl"
                    inertial_xyz="0.0194435327522072 3.59561199017935E-08 -0.0762921646103218"
