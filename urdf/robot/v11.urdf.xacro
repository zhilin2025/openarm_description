    <xacro:v11_finger link_name="openarm_right_link9"
                      visual_mesh="meshes/ee/openarm_hand_v2/visual/openarm_right_link9.stl"
                      collision_mesh="meshes/ee/openarm_hand_v2/collision/openarm_right_link9.stl"
                      inertial_xyz="0.00199225371493203 -0.00172789266709448 -0.0246225281341831"
                      inertial_rpy="0 0 0"
                      mass="0.293281702496599"
                      ixx="0.000116867743310699"
