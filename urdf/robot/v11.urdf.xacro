<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm_v11">

  <xacro:include filename="$(find openarm_description)/urdf/ros2_control/openarm.ros2_control.xacro" />
  <xacro:include filename="$(find openarm_description)/urdf/ros2_control/openarm.bimanual.ros2_control.xacro" />

  <xacro:arg name="arm_type" default="v11" />
  <xacro:arg name="body_type" default="v11" />
  <xacro:arg name="ee_type" default="openarm_hand_v2" />
  <xacro:arg name="bimanual" default="true" />
  <xacro:arg name="hand" default="true" />
  <xacro:arg name="ros2_control" default="false" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="can_interface" default="can0" />
  <xacro:arg name="left_can_interface" default="can1" />
  <xacro:arg name="right_can_interface" default="can0" />
  <xacro:arg name="arm_prefix" default="" />
  <xacro:arg name="left_arm_prefix" default="left_" />
  <xacro:arg name="right_arm_prefix" default="right_" />
  <xacro:arg name="motor_backend" default="robstride" />
  <xacro:arg name="robstride_master_id" default="253" />
  <xacro:arg name="robstride_joint_ids" default="1,2,3,4,5,6,7" />
  <xacro:arg name="robstride_joint_types" default="3,3,6,6,0,0,0" />
  <xacro:arg name="robstride_gripper_id" default="8" />
  <xacro:arg name="robstride_gripper_type" default="0" />
  <xacro:arg name="auto_return_to_zero_on_activate" default="false" />
  <xacro:arg name="limit_margin" default="0.1" />
  <xacro:arg name="limit_stop_margin" default="0.02" />
  <xacro:arg name="limit_decel_factor" default="0.2" />
  <xacro:arg name="zero_torque_kd" default="0.3" />

  <xacro:property name="arm_type" value="$(arg arm_type)" />
  <xacro:property name="body_type" value="$(arg body_type)" />
  <xacro:property name="ee_type" value="$(arg ee_type)" />
  <xacro:property name="bimanual" value="$(arg bimanual)" />
  <xacro:property name="hand" value="$(arg hand)" />
  <xacro:property name="ros2_control" value="$(arg ros2_control)" />
  <xacro:property name="use_fake_hardware" value="$(arg use_fake_hardware)" />
  <xacro:property name="can_interface" value="$(arg can_interface)" />
  <xacro:property name="left_can_interface" value="$(arg left_can_interface)" />
  <xacro:property name="right_can_interface" value="$(arg right_can_interface)" />
  <xacro:property name="arm_prefix" value="$(arg arm_prefix)" />
  <xacro:property name="left_arm_prefix" value="$(arg left_arm_prefix)" />
  <xacro:property name="right_arm_prefix" value="$(arg right_arm_prefix)" />
  <xacro:property name="motor_backend" value="$(arg motor_backend)" />
  <xacro:property name="robstride_master_id" value="$(arg robstride_master_id)" />
  <xacro:property name="robstride_joint_ids" value="$(arg robstride_joint_ids)" />
  <xacro:property name="robstride_joint_types" value="$(arg robstride_joint_types)" />
  <xacro:property name="robstride_gripper_id" value="$(arg robstride_gripper_id)" />
  <xacro:property name="robstride_gripper_type" value="$(arg robstride_gripper_type)" />
  <xacro:property name="auto_return_to_zero_on_activate" value="$(arg auto_return_to_zero_on_activate)" />
  <xacro:property name="limit_margin" value="$(arg limit_margin)" />
  <xacro:property name="limit_stop_margin" value="$(arg limit_stop_margin)" />
  <xacro:property name="limit_decel_factor" value="$(arg limit_decel_factor)" />
  <xacro:property name="zero_torque_kd" value="$(arg zero_torque_kd)" />

  <xacro:property name="v11_root_name" value="openarm_body_link0" />

  <xacro:macro name="v11_link" params="name visual_mesh collision_mesh inertial_xyz inertial_rpy mass ixx ixy ixz iyy iyz izz">
    <link name="${name}">
      <visual name="${name}_visual">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://openarm_description/${visual_mesh}" />
        </geometry>
      </visual>
      <collision name="${name}_collision">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://openarm_description/${collision_mesh}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${inertial_xyz}" rpy="${inertial_rpy}" />
        <mass value="${mass}" />
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}" />
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="v11_joint" params="name parent child xyz axis lower upper effort velocity">
    <joint name="${name}" type="revolute">
      <origin xyz="${xyz}" rpy="0 0 0" />
      <parent link="${parent}" />
      <child link="${child}" />
      <axis xyz="${axis}" />
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}" />
    </joint>
  </xacro:macro>

  <xacro:macro name="v11_finger" params="link_name visual_mesh collision_mesh inertial_xyz inertial_rpy mass ixx ixy ixz iyy iyz izz joint_name parent child xyz axis lower upper effort velocity mimic:='none'">
    <xacro:v11_link name="${link_name}"
                    visual_mesh="${visual_mesh}"
                    collision_mesh="${collision_mesh}"
                    inertial_xyz="${inertial_xyz}"
                    inertial_rpy="${inertial_rpy}"
                    mass="${mass}"
                    ixx="${ixx}"
                    ixy="${ixy}"
                    ixz="${ixz}"
                    iyy="${iyy}"
                    iyz="${iyz}"
                    izz="${izz}" />
    <joint name="${joint_name}" type="prismatic">
      <origin xyz="${xyz}" rpy="0 0 0" />
      <parent link="${parent}" />
      <child link="${child}" />
      <axis xyz="${axis}" />
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}" />
      <xacro:if value="${mimic != 'none'}">
        <mimic joint="${mimic}" multiplier="-1" offset="0" />
      </xacro:if>
    </joint>
  </xacro:macro>

