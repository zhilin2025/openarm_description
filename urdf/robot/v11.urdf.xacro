             xyz="-0.0199 0 0" axis="-1 0 0" lower="-1.56" upper="1.56" effort="7" velocity="20.943946" />

    <xacro:v11_finger link_name="openarm_right_link8"
                      visual_mesh="meshes/ee/openarm_hand_v2/visual/openarm_right_link8.stl"
                      collision_mesh="meshes/ee/openarm_hand_v2/collision/openarm_right_link8.stl"
                      inertial_xyz="-0.00101811823961093 0.00172774224891818 -0.024621172594379"
                      inertial_rpy="0 0 0"
                      mass="0.293276331723124"
                      ixx="0.000116854064615415"
